# Test pools of the plugin's release ZIP next to a release of the test theme, for
# bin/run of wp-test-env (https://github.com/webcodingcat/wp-test-env), e.g. from its directory:
#
#   bin/run ../theme-dev-test/tests/release.pools ../plugin-dev-test/tests/release.pools
#
# Builds the plugin's release ZIP with the framework checkout. The theme is the release
# that with-theme in .github/workflows/release.yml names (downloaded by
# tests/download-with-theme), as in the release workflow: two framework versions side
# by side.
prepare plugin-dev-test
link saij/wp-app-framework=wp-app-framework
link saij/plugin-dev-test=plugin-dev-test
link saij/theme-dev-test=theme-dev-test
tools plugin-dev-test composer release -- --package-source=saij/wp-app-framework=../wp-app-framework
tools plugin-dev-test tests/download-with-theme

pool pdt-release
instances 2
theme-zip plugin-dev-test/tests/with-theme/theme-dev-test-*.zip
plugin-zip plugin-dev-test/dist/plugin-dev-test-*.zip
e2e plugin-dev-test

pool pdt-release-cli
theme-zip plugin-dev-test/tests/with-theme/theme-dev-test-*.zip
plugin-zip plugin-dev-test/dist/plugin-dev-test-*.zip
run plugin-dev-test/tests/cli/run {instance}

pool pdt-release-lifecycle
theme-zip plugin-dev-test/tests/with-theme/theme-dev-test-*.zip
plugin-zip plugin-dev-test/dist/plugin-dev-test-*.zip
run plugin-dev-test/tests/lifecycle/run {instance}
