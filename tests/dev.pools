# Test pools of the plugin in development mode, for bin/run of wp-test-env
# (https://github.com/webcodingcat/wp-test-env), e.g. from its directory:
#
#   bin/run ../plugin-dev-test/tests/dev.pools
#
# Every instance runs the checkouts with the framework checkout linked into vendor/;
# the plugin's tests need the test theme theme-dev-test.
prepare theme-dev-test plugin-dev-test
link webcodingcat/wp-app-framework=wp-app-framework
link webcodingcat/plugin-dev-test=plugin-dev-test
link webcodingcat/theme-dev-test=theme-dev-test

pool pdt
instances 2
themes theme-dev-test
plugins plugin-dev-test
activate theme-dev-test
e2e plugin-dev-test

pool pdt-cli
themes theme-dev-test
plugins plugin-dev-test
activate theme-dev-test
run plugin-dev-test/tests/cli/run {instance}

# Deactivates, activates and uninstalls the plugin.
pool pdt-lifecycle
themes theme-dev-test
plugins plugin-dev-test
activate theme-dev-test
run plugin-dev-test/tests/lifecycle/run {instance}
