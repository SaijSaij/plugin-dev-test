#!/usr/bin/env bash
# WP-CLI tests of the plugin: runs its command of src/Cli/ next to the commands of
# the test theme (two framework instances with separate namespaces) and checks
# their output and exit codes. The command of the theme is checked only if the
# active theme offers it (theme-dev-test with its WP-CLI commands, as active theme
# or as parent of the active child theme); otherwise the check is skipped. Run it
# against an instance of wp-test-env (https://github.com/webcodingcat/wp-test-env,
# checked out next to this repository) in development mode (checkouts) or release
# mode (release ZIPs):
#
#   plugin-dev-test/tests/cli/run <instance>
set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: $0 <instance of wp-test-env>" >&2
    exit 2
fi
instance="$1"
# wp-test-env is checked out next to this repository.
test_env="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)/wp-test-env"
if [[ ! -x "${test_env}/bin/wp" ]]; then
    echo "ERROR: ${test_env}/bin/wp not found; check out wp-test-env (https://github.com/webcodingcat/wp-test-env) next to this repository." >&2
    exit 2
fi

stderr_file="$(mktemp)"
trap 'rm -f "${stderr_file}"' EXIT
failures=0
stdout=''
stderr=''
status=0

# Runs wp in the instance as the web server user; sets stdout, stderr and status.
wp_cli() {
    set +e
    stdout="$("${test_env}/bin/wp" "${instance}" "$@" 2>"${stderr_file}")"
    status=$?
    set -e
    stderr="$(cat "${stderr_file}")"
}

fail() {
    echo "FAIL: $1" >&2
    echo "  exit code: ${status}" >&2
    echo "  stdout: ${stdout}" >&2
    echo "  stderr: ${stderr}" >&2
    failures=$((failures + 1))
}

# expect_stdout <test> <exit code> <exact stdout>
expect_stdout() {
    if [[ "${status}" -ne "$2" || "${stdout}" != "$3" ]]; then
        fail "$1 (expected exit code $2 and stdout: $3)"
    else
        echo "ok: $1"
    fi
}

# expect_output <test> <exit code> <text in stdout or stderr>...
expect_output() {
    local name="$1" code="$2" text
    shift 2
    if [[ "${status}" -ne "${code}" ]]; then
        fail "${name} (expected exit code ${code})"
        return
    fi
    for text in "$@"; do
        if [[ "${stdout}${stderr}" != *"${text}"* ]]; then
            fail "${name} (expected output: ${text})"
            return
        fi
    done
    echo "ok: ${name}"
}

wp_cli plugin-dev-test check ping
expect_stdout 'command of the plugin' 0 'pong from plugin-dev-test'

wp_cli plugin-dev-test check ping again
expect_stdout 'optional argument of the plugin command' 0 'pong from plugin-dev-test again'

wp_cli help plugin-dev-test
expect_output 'namespace of the plugin' 0 'Commands of the plugin plugin-dev-test.' 'check'

wp_cli plugin-dev-test check values hello --mode=full
expect_output 'commands of the theme are not in the namespace of the plugin' 1 "'values' is not a registered subcommand of 'plugin-dev-test check'"

# The theme's command only if the active theme offers it, like the browser tests branch on the plugin status.
wp_cli cli has-command 'dev-test check values'
if [[ "${status}" -eq 0 ]]; then
    wp_cli dev-test check values hello --mode=full
    expect_stdout 'command of the theme next to the plugin' 0 '{"text":["hello","string"],"count":[1,"int"],"ratio":[null,"null"],"mode":["full","CheckMode::Full"],"upper":[false,"bool"]}'
elif [[ "${status}" -eq 1 && -z "${stderr}" ]]; then
    echo "skip: command of the theme next to the plugin (the active theme has no 'wp dev-test check values')"
else
    fail 'wp cli has-command (expected exit code 0 or 1)'
fi

if [[ "${failures}" -ne 0 ]]; then
    echo "${failures} WP-CLI test(s) failed against ${instance}." >&2
    exit 1
fi
echo "All WP-CLI tests passed against ${instance}."
