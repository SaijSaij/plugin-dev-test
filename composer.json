{
    "name": "saij/plugin-dev-test",
    "description": "Test plugin for wp-app-framework: its build and browser tests run against this plugin next to the test theme.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "saij/wp-app-framework": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Saij\\PluginDevTest\\": "src/"
        }
    },
    "scripts": {
        "build-manifest": "wp-app-framework build",
        "lint": [
            "phpstan analyse --no-progress --memory-limit=1G",
            "php-cs-fixer check --diff"
        ],
        "fix": "php-cs-fixer fix",
        "release": "wp-app-framework release"
    },
    "extra": {
        "wp-app-framework": {
            "namespace": "plugin-dev-test"
        },
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "Saij\\PluginDevTest\\Vendor\\",
            "classmap_prefix": "Saij_PluginDevTest_Vendor_",
            "include_root_autoload": true,
            "update_call_sites": [
                "src",
                "plugin-dev-test.php"
            ],
            "delete_vendor_packages": false
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "scripts-descriptions": {
        "build-manifest": "Builds and checks the manifest (writes nothing).",
        "release": "Builds the release ZIP into dist/ (see https://webcodingcat.github.io/wp-app-framework/next/build-and-release/release.html)."
    }
}
